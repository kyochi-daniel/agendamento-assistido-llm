{
  "name": "agendamento-assistido-llm",
  "version": "1.0.0",
  "description": "Demonstração acadêmica de agendamento fictício por operador com LangGraph e saída estruturada.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "test": "node --test tests/*.unit.test.ts",
    "test:unit": "node --test tests/*.unit.test.ts",
    "test:e2e": "node --env-file=.env --test tests/*.e2e.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "langgraph",
    "structured-output",
    "openrouter",
    "academic-demo"
  ],
  "author": "erickwendel",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@langchain/core": "^1.1.19",
    "@langchain/openai": "^1.2.5",
    "fastify": "^5.7.4",
    "langchain": "^1.2.17",
    "@langchain/langgraph": "^1.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
