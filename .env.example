# Nunca use dados clínicos ou pessoais reais nesta demonstração.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
# Escolha um modelo compatível com saída estruturada no provedor.
OPENROUTER_MODEL=replace-with-compatible-model-id
# Gere localmente com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OPERATOR_API_KEY=replace-with-random-operator-key-at-least-32-characters
HOST=127.0.0.1
PORT=3000
# Somente o teste opcional de integração exige RUN_PAID_E2E=1.
